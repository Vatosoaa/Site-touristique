datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model Tour {
  id          Int    @id @default(autoincrement())
  title       String
  price       String
  amenities   String
  description String
  image       String
}

model Package {
  id          Int    @id @default(autoincrement())
  title       String
  region      String
  price       String
  description String
  image       String
}

model BlogPost {
  id                Int      @id @default(autoincrement())
  title             String
  excerpt           String
  date              String
  categories        String[]
  contentParagraphs String[]
  contentImages     String[]
  tags              String[]
  authorQuote       String?
  image             String
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  permissions String[]   // e.g. ["manage_tours", "manage_packages", "manage_blog", "manage_messages", "manage_employees"]
  employees   Employee[]
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  bio       String?
  status    String   @default("Actif") // "Actif", "En congé", "Inactif"
  color     String   @default("bg-indigo-500")
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  status      String     @default("À faire") // "À faire", "En cours", "Terminé"
  priority    String     @default("Moyenne") // "Basse", "Moyenne", "Haute"
  color       String     @default("bg-violet-500")
  employees   Employee[]
  emailSent   Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  location    String   @default("")
  distance    String   @default("")
  price       String   @default("")
  rating      Float    @default(5.0)
  image       String   @default("")
  createdAt   DateTime @default(now())
}

model Temoignage {
  id        Int      @id @default(autoincrement())
  author    String
  avatar    String?  @default("")
  rating    Int      @default(5)
  content   String
  trip      String?  @default("")
  createdAt DateTime @default(now())
}

